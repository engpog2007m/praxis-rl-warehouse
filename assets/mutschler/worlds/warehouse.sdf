<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="praxis_warehouse">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane>
            <normal>0 0 1</normal>
            <size>36.6 36.0</size>
          </plane></geometry>
        </collision>
      </link>
    </model>
    <model name="north_wall"><static>true</static>
      <pose>18.300 36.000 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry>
        <box><size>36.6 0.3 3.0</size></box>
      </geometry></collision></link></model>
    <model name="south_wall"><static>true</static>
      <pose>18.300 0.000 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry>
        <box><size>36.6 0.3 3.0</size></box>
      </geometry></collision></link></model>
    <model name="east_wall"><static>true</static>
      <pose>36.600 18.000 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry>
        <box><size>0.3 36.0 3.0</size></box>
      </geometry></collision></link></model>
    <model name="west_wall"><static>true</static>
      <pose>0.000 18.000 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry>
        <box><size>0.3 36.0 3.0</size></box>
      </geometry></collision></link></model>
  </world>
</sdf>